{
  "manifest_version": 3,
  "name": "OnHockey.tv RPC",
  "version": "1.1.0",
  "description": "Détecte le match regardé sur onhockey.tv et l'envoie à OnHockey.tv RPC pour la Rich Presence Discord.",
  "icons": { "128": "icon128.png" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:47823/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://onhockey.tv/*", "*://*.onhockey.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } }
}
